# External LLM backends (optional). Qwen is the default local backend and
# needs neither of these — required only when a user explicitly selects a
# non-local model (--model claude-*/gpt-*, or the `model` API/UI field) and
# passes external_ok=true, since that sends case text to a third-party API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
